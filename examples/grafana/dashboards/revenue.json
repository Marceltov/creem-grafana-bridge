{
  "uid": "revenue",
  "title": "Revenue",
  "tags": [
    "creem",
    "revenue"
  ],
  "timezone": "Europe/Berlin",
  "editable": true,
  "schemaVersion": 41,
  "graphTooltip": 1,
  "refresh": "",
  "time": {
    "from": "now-12M/M",
    "to": "now+12M/M"
  },
  "description": "Revenue, cashflow, forecast and payouts of the Creem stores, from creem-grafana-bridge.",
  "links": [
    {
      "title": "Creem dashboard",
      "url": "https://www.creem.io/dashboard",
      "type": "link",
      "targetBlank": true,
      "icon": "external link"
    }
  ],
  "templating": {
    "list": [
      {
        "name": "basis",
        "label": "Amounts",
        "type": "custom",
        "query": "net : net,gross : gross",
        "current": {
          "text": "net",
          "value": "net"
        },
        "options": [
          {
            "text": "net",
            "value": "net",
            "selected": true
          },
          {
            "text": "gross",
            "value": "gross",
            "selected": false
          }
        ],
        "description": "net: after VAT and Creem's fee. gross: what customers paid, VAT included."
      },
      {
        "name": "store",
        "label": "Store",
        "type": "query",
        "datasource": {
          "type": "yesoreyeram-infinity-datasource",
          "uid": "revenue"
        },
        "multi": true,
        "includeAll": true,
        "current": {
          "text": "All",
          "value": "$__all"
        },
        "refresh": 1,
        "query": {
          "refId": "stores",
          "datasource": {
            "type": "yesoreyeram-infinity-datasource",
            "uid": "revenue"
          },
          "type": "json",
          "source": "url",
          "parser": "backend",
          "url": "/stores",
          "url_options": {
            "method": "GET"
          },
          "root_selector": "",
          "columns": [],
          "filters": [],
          "format": "table"
        }
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Revenue, this month",
      "description": "What this month's share of all payments comes to: a yearly payment counts about 1/12 per month. Basis as chosen above.",
      "datasource": {
        "type": "yesoreyeram-infinity-datasource",
        "uid": "revenue"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "yesoreyeram-infinity-datasource",
            "uid": "revenue"
          },
          "type": "json",
          "source": "url",
          "parser": "backend",
          "format": "timeseries",
          "url": "/series?kind=revenue&basis=$basis&store=${store:csv}&from=now/M&to=now%2B1M/M&by=total&currency=EUR",
          "url_options": {
            "method": "GET",
            "data": ""
          },
          "root_selector": "",
          "columns": [
            {
              "selector": "time",
              "text": "time",
              "type": "timestamp"
            },
            {
              "selector": "amount",
              "text": "amount",
              "type": "number"
            },
            {
              "selector": "store",
              "text": "total",
              "type": "string"
            }
          ],
          "filters": []
        }
      ],
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 4,
        "h": 4
