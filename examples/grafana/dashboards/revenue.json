            "type": "yesoreyeram-infinity-datasource",
            "uid": "revenue"
          },
          "type": "json",
          "source": "url",
          "parser": "backend",
          "format": "timeseries",
          "url": "/series?kind=revenue&basis=$basis&store=${store:csv}&from=${__from}&to=${__to}&per=date&by=plan&currency=EUR",
          "url_options": {
            "method": "GET",
            "data": ""
          },
          "root_selector": "",
          "columns": [
            {
              "selector": "time",
              "text": "time",
              "type": "timestamp"
            },
            {
              "selector": "amount",
              "text": "amount",
              "type": "number"
